[Unit]
Description=Diskwatch local web dashboard
After=diskwatch-collector.service

[Service]
Type=simple
DynamicUser=yes
SupplementaryGroups=diskwatch-data
ExecStart=/usr/bin/python3 -B /usr/local/lib/diskwatch/diskwatch.py serve
Restart=on-failure
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_UNIX

[Install]
WantedBy=multi-user.target
